{
  "name": "hatchabot",
  "version": "2.31.3",
  "private": true,
  "type": "module",
  "description": "Deployment & management layer for OpenClaw agents",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "hatchabot": "bin/hatchabot.mjs"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "e2e": "tsx scripts/e2e.ts",
    "typecheck": "tsc --noEmit",
    "check:web": "node scripts/check-web.mjs",
    "test": "npm run check:web && vitest run",
    "e2e:docker": "tsx scripts/e2e-docker.ts",
    "smoke:adopt": "bash scripts/smoke-adopt.sh",
    "smoke:adopt:full": "tsx scripts/smoke-adopt-full.ts",
    "smoke": "bash scripts/smoke.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.119.0",
    "@fastify/cookie": "^11.1.2",
    "better-sqlite3": "^13.0.1",
    "fastify": "^5.12.5",
    "grammy": "^1.45.1",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.13",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "fast-uri": "^4.1.5"
  }
}
