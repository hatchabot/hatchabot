# Copy to .env (chmod 600). scripts/setup-host.sh generates this for you.

# REQUIRED — encrypts stored bot tokens and API keys. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this means re-entering every credential.
AGENTCLAW_SECRET_KEY=

# App password (password auth mode).
AGENTCLAW_PASSWORD=

PORT=8080

# Canonical URL others use to reach this control plane; used in invite links.
# e.g. http://my-box.my-tailnet.ts.net:8080
# AGENTCLAW_PUBLIC_URL=

# --- optional ---------------------------------------------------------------
# AGENTCLAW_DB=data/agentclaw.sqlite
# AGENTCLAW_IMAGE=agentclaw-runtime:latest
# Running two installations on one host? Give each its own namespace:
# AGENTCLAW_PREFIX=agentclaw
# AGENTCLAW_GATEWAY_PORT_BASE=19100
# Per-agent container limits, and how long to wait on a docker command:
# AGENTCLAW_AGENT_MEMORY=2g
# AGENTCLAW_AGENT_PIDS=512
# AGENTCLAW_DOCKER_TIMEOUT_MS=60000
# AGENTCLAW_BACKUP_KEEP_DAYS=14
# Where nightly backups land (may be a NAS mount):
# AGENTCLAW_BACKUP_DIR=~/agentclaw-backups
# How often runtime state is re-checked (ms):
# AGENTCLAW_RECONCILE_MS=120000
# Listen address — defaults to 0.0.0.0, or 127.0.0.1 when no password is set:
# AGENTCLAW_BIND=0.0.0.0

# --- per-user accounts instead of one shared password (docs/identity.md) -----
# AGENTCLAW_AUTH=identity
# AGENTCLAW_GCP_PROJECT=
# AGENTCLAW_IDENTITY_API_KEY=
# AGENTCLAW_GOOGLE_CLIENT_ID=
