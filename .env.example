# Hatchabot control plane — .env reference
#
# Copy to .env next to package.json (chmod 600). Every line is KEY=VALUE; systemd
# reads this file verbatim (no ~ or $VAR expansion — use absolute paths).
#
# WHAT'S AUTOMATIC: scripts/setup-host.sh creates this file on a fresh install
# and fills in the three lines marked [auto]. Everything else is optional and
# has the default shown — you only add a line to change it. `hatchabot mgmt-bot
# setup` writes the separate .env.mgmt for the Telegram management bot.
# Pre-1.0 installs may still use AGENTCLAW_* names; they are aliased on start.

# ============================================================================
# REQUIRED
# ============================================================================

# [auto] Encrypts every stored credential (bot tokens, API keys, setup tokens)
# at rest. 64 hex chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# LOSING THIS MEANS RE-ENTERING EVERY CREDENTIAL — it is included in backups
# as secret-key.env; keep a copy somewhere safe.
HATCHABOT_SECRET_KEY=

# [auto] Password for the web app in password mode (the default auth mode).
# Not used in identity mode. Single-quote it if it contains spaces or symbols.
HATCHABOT_PASSWORD=

# [auto] HTTP port of the control plane.
PORT=8080

# ============================================================================
# RECOMMENDED
# ============================================================================

# The URL other people reach this control plane at — used in invite links and
# OAuth redirects. With Tailscale: https://<machine>.<tailnet>.ts.net
# HATCHABOT_PUBLIC_URL=

# Listen address. Default 0.0.0.0 when a password is set, 127.0.0.1 when not.
# HATCHABOT_BIND=0.0.0.0

# Native TLS instead of a fronting proxy (both required, PEM files):
# HATCHABOT_TLS_CERT=/absolute/path/cert.pem
# HATCHABOT_TLS_KEY=/absolute/path/key.pem

# ============================================================================
# DATA & BACKUPS
# ============================================================================

# SQLite registry + secret store. Default: data/hatchabot.sqlite inside the
# checkout. Production installs keep it OUTSIDE the checkout so a redeploy
# can never touch it (scripts/deploy-release.sh, docs/releasing.md).
# HATCHABOT_DB=/home/you/hatchabot-data/hatchabot.sqlite

# Nightly backups (one tarball per agent volume + the DB + the secret key).
# ABSOLUTE path; may be a NAS mount. Default: $HOME/hatchabot-backups.
# HATCHABOT_BACKUP_DIR=/home/you/hatchabot-backups
# HATCHABOT_BACKUP_KEEP_DAYS=14

# ============================================================================
# LIMITS (shared hosts)
# ============================================================================
# 0 or unset = no limit. Archived agents never count.

# Cap per account (everyone, host owner included).
# HATCHABOT_MAX_AGENTS_PER_ACCOUNT=50
# Lower cap for accounts that are NOT the host owner.
# HATCHABOT_MAX_AGENTS_PER_MEMBER=10
# Ceiling on live agents across every account — bounds what any number of
# sign-ups can do to the machine.
# HATCHABOT_MAX_AGENTS_TOTAL=80

# Per-agent container limits.
# HATCHABOT_AGENT_MEMORY=2g
# HATCHABOT_AGENT_PIDS=512

# Credential endpoints: failures allowed per client per window before 429.
# HATCHABOT_LOGIN_FAILS_PER_WINDOW=10
# HATCHABOT_LOGIN_WINDOW_MS=900000

# ============================================================================
# WHO CAN SIGN IN — three modes (docs/identity.md)
#
#   password  (default) one implicit user, one shared password: HATCHABOT_PASSWORD
#             above. Everything belongs to a single owner.
#   accounts  several people, each with their own username and password, kept
#             on this machine. Nothing to register anywhere — no Google
#             project, no cloud. Each account owns its own agents and sources.
#             Set HATCHABOT_AUTH=accounts, restart, then create account #1 in
#             the app (it adopts whatever password mode already owned).
#   identity  per-user sign-in via GCP Identity Platform (Google). Needs a
#             cloud project; the four keys below are required together.
#
# Switching password -> accounts (or -> identity) is supported and one-way in
# practice: going back leaves every per-account row behind a single owner.
# ============================================================================
# HATCHABOT_AUTH=accounts

# ---- identity mode only ----------------------------------------------------
# HATCHABOT_AUTH=identity
# Local username/password accounts ALONGSIDE Google sign-in: the owner uses
# Google, everyone else gets an invitation link. Identity mode only.
# HATCHABOT_LOCAL_ACCOUNTS=1
# HATCHABOT_GCP_PROJECT=
# HATCHABOT_IDENTITY_API_KEY=
# HATCHABOT_GOOGLE_CLIENT_ID=
# Optional allowlist: only these sign-in emails become accounts (403 for
# others). Unset = anyone the identity provider accepts. Unnecessary on a
# tailnet-only install — the tailnet is the allowlist.
# HATCHABOT_ALLOWED_EMAILS=you@example.com, partner@example.com

# ============================================================================
# DOCKER & RUNTIME
# ============================================================================

# Runtime image agents run on (build: scripts/build-runtime-image.sh).
# HATCHABOT_IMAGE=hatchabot-runtime:latest
# Namespace for container/volume names. Change only to run two installations
# on one host. Pre-1.0 agents keep their agentclaw- names; that's expected.
# HATCHABOT_PREFIX=hatchabot
# First loopback port for agents' debug gateways.
# HATCHABOT_GATEWAY_PORT_BASE=19100
# URL agents use to reach the control plane from inside Docker (A2A consults).
# HATCHABOT_INTERNAL_URL=http://172.17.0.1:8080
# How many rebuilds run at once (each rebuild is a checkpoint + a container swap).
# HATCHABOT_REBUILD_CONCURRENCY=3

# ============================================================================
# TIMEOUTS & SWEEPS (ms) — the defaults suit a local Docker daemon
# ============================================================================
# HATCHABOT_DOCKER_TIMEOUT_MS=60000        # one docker command
# HATCHABOT_DOCKER_IO_TIMEOUT_MS=900000    # volume import/export, seeding
# HATCHABOT_CHECKPOINT_TIMEOUT_MS=180000   # Chat → Memory before a rebuild
# HATCHABOT_READY_TIMEOUT_MS=90000         # wait for a new container's gateway
# HATCHABOT_READY_POLL_MS=3000
# HATCHABOT_RECONCILE_MS=120000            # runtime state re-check
# HATCHABOT_BOOT_RECONCILE_MS=30000        # max time the boot sweep may delay /healthz
# HATCHABOT_NAME_REPAIR_MS=120000          # Telegram bot name/description repair
# HATCHABOT_IDLE_RENAME_MS=900000          # rename a bot only after this much idle
# HATCHABOT_POSTURE_SWEEP_MS=86400000      # security posture snapshot
# HATCHABOT_USAGE_SAMPLE_MS=600000         # AI source usage + rate-limit sampling
# HATCHABOT_CLI_TIMEOUT_MS=180000          # claude CLI turn (Claude Max sources)
# HATCHABOT_CLAUDE_BIN=                    # path to `claude` if not on PATH
# HATCHABOT_SSH_DIR=                       # where runner SSH keys/config live (default ~/.ssh)

# ============================================================================
# NEVER IN PRODUCTION
# ============================================================================
# Lets a request header choose the owner — for tests only. The security
# posture check flags it CRITICAL if set.
# HATCHABOT_ALLOW_OWNER_HEADER=1

# ----------------------------------------------------------------------------
# Not in this file: the CLI reads HATCHABOT_URL / HATCHABOT_TOKEN from
# ~/.config/hatchabot/env (written by `hatchabot login`); scripts/*.sh accept
# HATCHABOT_PROD_DIR, HATCHABOT_SERVICE, HATCHABOT_HEALTH_URL, HATCHABOT_REPO,
# HATCHABOT_IMAGE_REPO, HATCHABOT_AGENT_DISK_WARN_GB, HATCHABOT_DRILL_DB and
# the HATCHABOT_SMOKE_* test knobs on their command line.
