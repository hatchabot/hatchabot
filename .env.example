# Hatchabot settings
#   Lines without # are in force. Every other setting is listed with its
#   default: remove the # and change the value to use it, then restart.
#   Hatchabot keeps this file in order when it starts; your values, and
#   anything it does not know (under "Other settings"), are kept as written.
#   KEY=VALUE only: systemd reads it as is (no ~ or $VAR; absolute paths).
#   (This is .env.example: the same file for an empty install.)

# ~~ Basics ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# Encrypts every stored credential. Made by the installer; losing it means
# re-entering every token and key. Backups include it as secret-key.env.
# HATCHABOT_SECRET_KEY=

# How people sign in: accounts, password or identity. The installer writes
# accounts.
# HATCHABOT_AUTH=password

# The shared password in password mode. Single-quote it if it has spaces or
# symbols (no apostrophes).
# HATCHABOT_PASSWORD=

# The web app's port.
# PORT=8080

# The address other people reach this machine at, for invite links and Google
# sign-in, e.g. https://<machine>.<tailnet>.ts.net. Unset: localhost.
# HATCHABOT_PUBLIC_URL=

# Listen address. Unset: 0.0.0.0 when sign-in is on, 127.0.0.1 when it is off.
# HATCHABOT_BIND=

# Serve HTTPS directly: the certificate (PEM, absolute path). Set both this
# and HATCHABOT_TLS_KEY, or neither.
# HATCHABOT_TLS_CERT=

# The certificate's key (PEM, absolute path).
# HATCHABOT_TLS_KEY=

# ~~ Sign-in ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#   Modes: accounts (a login per person, kept here), password (one shared
#   password), identity (Google sign-in; docs/identity.md).

# How long a Google sign-in lasts before it asks again. "Sign out on every
# device" ends them sooner.
# HATCHABOT_SESSION_DAYS=14

# Identity mode: only these Google addresses may sign in, comma-separated.
# Unset: any Google account that reaches this machine.
# HATCHABOT_ALLOWED_EMAILS=

# Identity mode: 1 also allows local username/password accounts (the owner
# uses Google, others get an invitation link).
# HATCHABOT_LOCAL_ACCOUNTS=

# Identity mode: the Google Cloud project.
# HATCHABOT_GCP_PROJECT=

# Identity mode: the Identity Platform API key.
# HATCHABOT_IDENTITY_API_KEY=

# Identity mode: the OAuth client id.
# HATCHABOT_GOOGLE_CLIENT_ID=

# Failed sign-ins allowed per client per window before it is refused for a
# while.
# HATCHABOT_LOGIN_FAILS_PER_WINDOW=10

# That window.
# HATCHABOT_LOGIN_WINDOW_MS=900000

# ~~ Public access ("Reach it from anywhere") ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#   Off unless HATCHABOT_PUBLIC_ACCESS is set. Turn it on from Settings or
#   `hatchabot reach on`, which checks every safeguard first
#   (docs/public-access.md).

# funnel makes the sign-in page reachable from the internet through Tailscale
# Funnel. Unset or off: private only. On with any safeguard off, the public
# address answers 503 and `hatchabot doctor` fails.
# HATCHABOT_PUBLIC_ACCESS=

# The public address, written when public access is turned on
# (https://<machine>.<tailnet>.ts.net:8443).
# HATCHABOT_PUBLIC_ACCESS_URL=

# 1: at the public address only existing accounts and pending invitations may
# sign in. Public access needs it on.
# HATCHABOT_PUBLIC_INVITED_ONLY=

# 1: everyone needs a second factor at the public address, not only accounts
# with owner rights (they add their first one there, with their password).
# HATCHABOT_PUBLIC_SECOND_FACTOR_FOR_ALL=

# The public listener's port on this machine (127.0.0.1 only). Funnel is
# pointed at this port and no other; everything arriving on it is treated as a
# stranger.
# HATCHABOT_PUBLIC_PORT=8092

# The port of the public address: 443, 8443 or 10000 (Funnel's choices). 8443
# leaves 443 to the private tailnet address.
# HATCHABOT_PUBLIC_FUNNEL_PORT=8443

# A sign-in at the public address ends after this long without use.
# HATCHABOT_PUBLIC_IDLE_MINUTES=720

# Machine-level and dangerous actions at the public address need the second
# factor given within this many minutes.
# HATCHABOT_PUBLIC_STEPUP_MINUTES=10

# Requests a minute the public address answers, all visitors together.
# HATCHABOT_PUBLIC_REQS_PER_MIN=3000

# Requests a minute from one address.
# HATCHABOT_PUBLIC_REQS_PER_MIN_PER_ADDRESS=600

# Failed sign-ins per window at the public address, all visitors together,
# before every public sign-in is refused for the rest of the window.
# HATCHABOT_PUBLIC_FAILS_CEILING=100

# ~~ Data and backups ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# The registry and secret store (SQLite). Unset: data/hatchabot.sqlite in this
# folder. Production keeps it outside the checkout.
# HATCHABOT_DB=

# Where nightly backups go (absolute path; may be a NAS mount). Unset:
# ~/hatchabot-backups.
# HATCHABOT_BACKUP_DIR=

# How many days of nightly backups to keep.
# HATCHABOT_BACKUP_KEEP_DAYS=14

# ~~ Limits ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#   0 or unset = no limit. Archived agents never count.

# Most agents one account may have (the host owner included).
# HATCHABOT_MAX_AGENTS_PER_ACCOUNT=0

# A lower cap for accounts that are not the host owner.
# HATCHABOT_MAX_AGENTS_PER_MEMBER=0

# Most live agents on this machine, all accounts together.
# HATCHABOT_MAX_AGENTS_TOTAL=0

# Each agent's memory limit (also Settings → Hosts → Defaults).
# HATCHABOT_AGENT_MEMORY=3g

# The most a member may give one agent; the machine owner is not bound by it.
# HATCHABOT_AGENT_MEMORY_MAX=8g

# Each agent's process limit.
# HATCHABOT_AGENT_PIDS=512

# Warn when an agent's storage passes this size.
# HATCHABOT_AGENT_DISK_WARN_GB=10

# How big an imported .hatchabot file may expand to.
# HATCHABOT_IMPORT_MAX_GB=8

# Largest single download from an agent's Files tab.
# HATCHABOT_FILE_MAX_MB=512

# Largest file an agent sends or receives on Telegram (Telegram's own limit is
# 50).
# HATCHABOT_FILES_MB_TELEGRAM=50

# Largest file an agent sends on Discord (up to 500 on a boosted server).
# HATCHABOT_FILES_MB_DISCORD=10

# Largest file an agent sends or receives on Slack (up to 1000).
# HATCHABOT_FILES_MB_SLACK=100

# ~~ Agents ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# Put agents to sleep after this long without use, e.g. 36h (90m, 6h, 2d).
# Unset: they never sleep.
# HATCHABOT_HIBERNATE_AFTER=

# What the machine rebuilds on its own: required-only, auto (also recommended
# ones, in the quiet hours) or manual.
# HATCHABOT_REBUILD_POLICY=required-only

# Local hours for automatic rebuilds, "from-to" (wraps midnight).
# HATCHABOT_REBUILD_QUIET_HOURS=3-5

# Rebuilds at once, 1 to 12 (also Settings → Images).
# HATCHABOT_REBUILD_CONCURRENCY=6

# Conversations saved to memory at once before rebuilds.
# HATCHABOT_CHECKPOINT_CONCURRENCY=2

# Agent-to-agent consults running at once.
# HATCHABOT_A2A_MAX_CONCURRENT=8

# Consults one agent may start per hour.
# HATCHABOT_A2A_PER_HOUR=60

# How long a consult may take.
# HATCHABOT_A2A_TIMEOUT_MS=120000

# How long an "ask" from the app may take.
# HATCHABOT_ASK_TIMEOUT_MS=280000

# Messages one person may send one agent per hour from the web chat.
# HATCHABOT_WEB_CHAT_PER_HOUR=60

# off gives agents rebuilt from now on the token console again (no OpenClaw
# chat for web-chat guests). Set it, and rebuild, before going back to an
# older release.
# HATCHABOT_CONSOLE_IDENTITY=

# 1 allows NEW Claude sources that mount this machine's own ~/.claude into
# agents (read-write). Off since v2.39.0; use a setup token instead.
# HATCHABOT_ALLOW_MACHINE_LOGIN=

# ~~ Usage and spike warnings ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# Warn on Telegram when an agent's last 24 hours are this many times its usual
# day...
# HATCHABOT_USAGE_ALERT_RATIO=3

# ...and at least this many tokens.
# HATCHABOT_USAGE_ALERT_MIN_TOKENS=20000000

# An agent with under 3 measured days: warn at this many tokens in 24 hours.
# HATCHABOT_USAGE_ALERT_NEW_TOKENS=100000000

# How often usage and rate limits are read from the agents (0 = never).
# HATCHABOT_USAGE_SAMPLE_MS=600000

# Agents read at once in a usage pass.
# HATCHABOT_USAGE_CONCURRENCY=6

# Longest one usage pass may take.
# HATCHABOT_USAGE_PASS_MS=300000

# ~~ Memory search service ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#   One engine for every agent's memory search (Settings → Hosts → Memory search
#   service).

# What NEW agents get: baked (their own engine) or shared (this service).
# HATCHABOT_EMBED_DEFAULT=baked

# The service's port, on the address agents reach this machine at.
# HATCHABOT_EMBED_PORT=8093

# That address. Unset: found automatically (the Docker bridge gateway).
# HATCHABOT_EMBED_BIND=

# Calls a minute, per agent.
# HATCHABOT_EMBED_PER_MIN=600

# The engine's memory limit.
# HATCHABOT_EMBEDDER_MEMORY=2g

# The engine image. Unset: the one pinned by digest in this release.
# HATCHABOT_EMBEDDER_IMAGE=

# How often a running service is checked (and restarted if it stopped).
# HATCHABOT_EMBED_HEALTH_MS=300000

# Delay after start before the service is checked the first time.
# HATCHABOT_EMBED_BOOT_MS=15000

# Use a server you already run instead (Ollama speaks the same API). It must
# be reachable from the agents' containers, not 127.0.0.1.
# HATCHABOT_EMBED_URL=

# That server's key.
# HATCHABOT_EMBED_KEY=

# That server's model name.
# HATCHABOT_EMBED_MODEL=

# ~~ Docker and runtime ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# The image agents run on.
# HATCHABOT_IMAGE=hatchabot-runtime:latest

# Where published runtime images are pulled from.
# HATCHABOT_IMAGE_REGISTRY=ghcr.io/hatchabot/runtime

# Name prefix for containers and volumes. Change only to run two installations
# on one machine.
# HATCHABOT_PREFIX=hatchabot

# The Docker network agents run on (isolated from each other). bridge = the
# old shared network.
# HATCHABOT_AGENT_NETWORK=hatchabot-agents

# First loopback port for the agents' own gateways.
# HATCHABOT_GATEWAY_PORT_BASE=19100

# How agents reach this app from inside Docker. Unset: the Docker host address
# and PORT.
# HATCHABOT_INTERNAL_URL=

# The address agents use for this machine. Unset: found automatically.
# HATCHABOT_HOST_ALIAS_IP=

# 1 or 0 to say whether Docker is rootless. Unset: detected.
# HATCHABOT_DOCKER_ROOTLESS=

# 1 or 0 to say whether this is Docker Desktop. Unset: detected.
# HATCHABOT_DOCKER_DESKTOP=

# 1 publishes agent ports on 127.0.0.1 only. Unset: set automatically under
# rootless Docker.
# HATCHABOT_CONTAINERS_ON_LOOPBACK=

# The systemd unit of an OpenClaw install on this machine, for bringing its
# agents in.
# HATCHABOT_OPENCLAW_GATEWAY_UNIT=openclaw-gateway

# Path to the claude command, if it is not on PATH.
# HATCHABOT_CLAUDE_BIN=

# Where runner SSH keys and config live. Unset: ~/.ssh.
# HATCHABOT_SSH_DIR=

# ~~ Hatchabot agent (management) ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# The port the Hatchabot agent's tools are served on (reachable only from its
# own network).
# HATCHABOT_OPS_PORT=8091

# That port's address. Unset: where the agent's gatekeeper can reach it.
# HATCHABOT_OPS_BIND=

# Web connections the Hatchabot agent may hold open at once.
# HATCHABOT_OPS_MAX_TUNNELS=24

# Close such a connection after this long idle.
# HATCHABOT_OPS_TUNNEL_IDLE_MS=600000

# How often its setup is checked for drift.
# HATCHABOT_OPS_DRIFT_MS=600000

# An Anthropic key or setup token for the management chat when no AI source is
# chosen for it.
# HATCHABOT_MGMT_ANTHROPIC_KEY=

# ~~ Managed installs (a provider running Hatchabot for someone) ~~~~~~~~~~~

# Who runs this install, shown in the app.
# HATCHABOT_MANAGED_BY=

# Their support link, shown with it.
# HATCHABOT_SUPPORT_URL=

# A notice shown at the top of the app.
# HATCHABOT_NOTICE=

# 1 lets a hosted install (HATCHABOT_MANAGED_BY set) add Claude plan sources
# (setup token, machine login). Unset: hosted installs take Claude by API key
# only, as Anthropic's terms require of a provider without its written
# agreement.
# HATCHABOT_MANAGED_ALLOW_CLAUDE_PLAN=

# One-time sign-in links from the provider's account page: the Ed25519 PUBLIC
# key (PEM, absolute path, chmod 600) they are signed with;
# HATCHABOT_PUBLIC_URL must be set. Unset: no links (docs/signin-links.md).
# HATCHABOT_SIGNIN_KEY_FILE=

# ~~ Timeouts and sweeps (milliseconds) ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#   The defaults suit a local Docker daemon.

# One docker command.
# HATCHABOT_DOCKER_TIMEOUT_MS=60000

# Copying an agent's storage in or out, and seeding it.
# HATCHABOT_DOCKER_IO_TIMEOUT_MS=900000

# Saving a conversation to memory before a rebuild.
# HATCHABOT_CHECKPOINT_TIMEOUT_MS=180000

# Waiting for a new container to answer.
# HATCHABOT_READY_TIMEOUT_MS=90000

# How often it is asked while waiting.
# HATCHABOT_READY_POLL_MS=3000

# Building a runtime image.
# HATCHABOT_BASE_BUILD_TIMEOUT_MS=5400000

# One claude command turn (Claude Max sources).
# HATCHABOT_CLI_TIMEOUT_MS=180000

# An agent's console page loading.
# HATCHABOT_CONSOLE_TIMEOUT_MS=60000

# Waking a sleeping agent.
# HATCHABOT_WAKE_TIMEOUT_MS=120000

# How often sleeping agents are checked for new messages.
# HATCHABOT_WAKE_POLL_MS=20000

# How often idle agents are looked for.
# HATCHABOT_HIBERNATE_SWEEP_MS=300000

# How often waiting rebuilds are looked for.
# HATCHABOT_REBUILD_SWEEP_MS=300000

# How often chat access settings are checked.
# HATCHABOT_PAIRING_SWEEP_MS=300000

# How often each agent's real state is re-checked.
# HATCHABOT_RECONCILE_MS=120000

# Longest the start-up check may delay the app.
# HATCHABOT_BOOT_RECONCILE_MS=30000

# Delay after start before stale session settings are cleared.
# HATCHABOT_PINS_BOOT_MS=60000

# How often Telegram bot names are repaired.
# HATCHABOT_NAME_REPAIR_MS=120000

# Rename a bot only after it has been idle this long.
# HATCHABOT_IDLE_RENAME_MS=900000

# How long a "someone is knocking" answer is reused.
# HATCHABOT_KNOCK_CACHE_MS=30000

# How often the security check runs.
# HATCHABOT_POSTURE_SWEEP_MS=86400000

# ~~ Never in production ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# 1 lets a request header choose the owner. For tests only; the security check
# flags it as critical.
# HATCHABOT_ALLOW_OWNER_HEADER=
