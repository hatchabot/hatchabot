# Copy to .env (chmod 600). scripts/setup-host.sh generates this for you.

# REQUIRED — encrypts stored bot tokens and API keys. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this means re-entering every credential.
HATCHABOT_SECRET_KEY=

# App password (password auth mode).
HATCHABOT_PASSWORD=

PORT=8080

# Canonical URL others use to reach this control plane; used in invite links.
# e.g. http://my-box.my-tailnet.ts.net:8080
# HATCHABOT_PUBLIC_URL=

# --- optional ---------------------------------------------------------------
# HATCHABOT_DB=data/hatchabot.sqlite
# HATCHABOT_IMAGE=hatchabot-runtime:latest
# Running two installations on one host? Give each its own namespace:
# HATCHABOT_PREFIX=hatchabot
# HATCHABOT_GATEWAY_PORT_BASE=19100
# Per-agent container limits, and how long to wait on a docker command:
# HATCHABOT_AGENT_MEMORY=2g
# HATCHABOT_AGENT_PIDS=512
# HATCHABOT_DOCKER_TIMEOUT_MS=60000
# HATCHABOT_BACKUP_KEEP_DAYS=14
# Where nightly backups land (may be a NAS mount). Use an ABSOLUTE path — this
# file is read by systemd's EnvironmentFile, which does NOT expand ~ (you would
# get a literal "~" directory). Default when unset: $HOME/hatchabot-backups.
# HATCHABOT_BACKUP_DIR=/home/you/hatchabot-backups
# How often runtime state is re-checked (ms):
# HATCHABOT_RECONCILE_MS=120000
# Listen address — defaults to 0.0.0.0, or 127.0.0.1 when no password is set:
# HATCHABOT_BIND=0.0.0.0
# Cap agents per account on a shared box (unset = no limit):
# HATCHABOT_MAX_AGENTS_PER_ACCOUNT=10

# --- per-user accounts instead of one shared password (docs/identity.md) -----
# HATCHABOT_AUTH=identity
# HATCHABOT_GCP_PROJECT=
# HATCHABOT_IDENTITY_API_KEY=
# HATCHABOT_GOOGLE_CLIENT_ID=
