# Hatchabot control plane — user-level systemd unit.
# Installed by scripts/install-service.sh into ~/.config/systemd/user/.
#
# Runs as your user (so it can reach docker and ~/.claude), restarts on crash,
# and starts at boot once lingering is enabled for the account.
[Unit]
Description=Hatchabot control plane
# After docker where docker is a user service (rootless): asked before the
# daemon is up, the first probe used to read as "root docker" for good.
After=docker.service

[Service]
WorkingDirectory=__HATCHABOT_DIR__
# Under a memory wall (a shared-host tenant slice) the kernel picks the biggest
# task: an agent container should go before the control plane (30th audit).
OOMScoreAdjust=-500
# Holds HATCHABOT_SECRET_KEY (and PORT). Never committed — see .gitignore.
EnvironmentFile=__HATCHABOT_DIR__/.env
# systemd user managers start with a minimal PATH; node (nvm) and docker can
# live outside it, so install-service.sh bakes their real locations in here.
Environment=PATH=__HATCHABOT_PATH__
# Quoted: systemd splits ExecStart on spaces, so a clone path with one broke it.
# with-docker.sh: right after the installer added you to the docker group this
# user manager does not have it yet — the wrapper starts it through `sg docker`
# so no log-out is needed (2026-10-06).
ExecStart="__HATCHABOT_DIR__/scripts/with-docker.sh" "__HATCHABOT_DIR__/node_modules/.bin/tsx" src/index.ts
Restart=always
RestartSec=3
# tsx exits 143 on SIGTERM; that's a clean shutdown, not a failure.
SuccessExitStatus=143

[Install]
WantedBy=default.target
